minute":null,"quarter":null,"quarterMinute":null,"isTodayGame":false,"isUpcomingGame":true,"isPreviousGame":false,"home":{"name":"Crvena Zvezda Meridianbet Belgrade","abbreviatedName":"Crvena Zvezda","tls":"CZV","score":0,"code":"RED","imageUrls":"https://media-cdn.incrowdsports.com/d2eef4a8-62df-4fdd-9076-276004268515.png","streaks":null,"tla":"CZV"},"away":{"name":"Panathinaikos AKTOR Athens","abbreviatedName":"Panathinaikos","tls":"PAO","score":0,"code":"PAN","imageUrls":"https://media-cdn.incrowdsports.com/e3dff28a-9ec6-4faf-9d96-ecbc68f75780.png","streaks":null,"tla":"PAO"},"url":"/en/euroleague/game-center/2025-26/crvena-zvezda-meridianbet-belgrade-panathinaikos-aktor-athens/E2025/83/","renderMarker":true,"isTestGame":false,"venue":null},{"microsite":"euroleague","id":"6b8a4876-25bb-5bf2-82c4-835d25d7fbcd","code":69,"date":"2025-10-29T18:00:00.000Z","season":{"code":"E2025","name":"EuroLeague 2025-26","alias":"2025-26","year":2025},"group":{"id":"b423dc4c-c635-422d-ad84-83cbe5caf086","name":"Group Regular Season","order":1},"phaseType":{"code":"RS","name":"Regular Season","alias":"REGULAR SEASON","isGroupPhase":true},"round":{"round":7,"name":"Round 7","alias":"Round 7"},"status":"result","minute":"40:00","quarter":null,"quarterMinute":null,"isTodayGame":false,"isUpcomingGame":false,"isPreviousGame":true,"home":{"name":"Hapoel IBI Tel Aviv","abbreviatedName":"Hapoel Tel Aviv","tls":"HTA","score":97,"code":"HTA","imageUrls":"https://media-cdn.incrowdsports.com/cbb1c3ad-03d5-426a-b5ef-2832a4eee484.png","streaks":null,"tla":"HTA"},"away":{"name":"Partizan Mozzart Bet Belgrade","abbreviatedName":"Partizan","tls":"PAR","score":84,"code":"PAR","imageUrls":"https://media-cdn.incrowdsports.com/2681304e-77dd-4331-88b1-683078c0fb49.png","streaks":null,"tla":"PAR"},"url":"/en/euroleague/game-center/2025-26/hapoel-ibi-tel-aviv-partizan-mozzart-bet-belgrade/E2025/69/","renderMarker":true,"isTestGame":false,"venue":null},{"microsite":"euroleague","id":"6b8240d0-0067-5f30-b10f-8f211e6cb68d","code":70,"date":"2025-10-29T19:15:00.000Z","season":{"code":"E2025","name":"EuroLeague 2025-26","alias":"2025-26","year":2025},"group":{"id":"b423dc4c-c635-422d-ad84-83cbe5caf086","name":"Group Regular Season","order":1},"phaseType":{"code":"RS","name":"Regular Season","alias":"REGULAR SEASON","isGroupPhase":true},"round":{"round":7,"name":"Round 7","alias":"Round 7"},"status":"result","minute":"40:00","quarter":null,"quarterMinute":null,"isTodayGame":false,"isUpcomingGame":false,"isPreviousGame":true,"home":{"name":"Olympiacos Piraeus","abbreviatedName":"Olympiacos","tls":"OLY","score":87,"code":"OLY","imageUrls":"https://media-cdn.incrowdsports.com/789423ac-3cdf-4b89-b11c-b458aa5f59a6.png","streaks":null,"tla":"OLY"},"away":{"name":"AS Monaco","abbreviatedName":"Monaco","tls":"ASM","score":92,"code":"MCO","imageUrls":"https://media-cdn.incrowdsports.com/89ed276a-2ba3-413f-8ea2-b3be209ca129.png","streaks":null,"tla":"ASM"},"url":"/en/euroleague/game-center/2025-26/olympiacos-piraeus-as-monaco/E2025/70/","renderMarker":true,"isTestGame":false,"venue":null}],"heroComponent":{"featuredArticle":{"pageType":"Article","generatedUrl":"/en/euroleague/news/eb24-tickets-for-the-2025-euroleague-final-four-in-abu-dhabi-go-on-sale-february-26/","id":"e1f94d33-af58-448a-9c65-6bef862104cb","publishDate":"2025-02-10T08:16:29.774Z","lastModified":"2025-02-25T10:10:45.397Z","displayCategory":{"id":"814cab4a-6e9e-4667-ac8f-647704dc4fa3","text":"Final Four"},"author":{"name":null,"title":null,"imageUrl":null,"socialHandles":[]},"slug":"eb24-tickets-for-the-2025-euroleague-final-four-in-abu-dhabi-go-on-sale-february-26","heroMedia":{"content":{"contentType":"IMAGE","image":"https://media-cdn.incrowdsports.com/2ebba550-c730-48fb-aa4a-61fc7944507a.jpg?crop=1920%3A1080%3Anowe%3A0%3A0","title":null,"description":""},"title":"Tickets for the 2025 EuroLeague Final Four in Abu Dhabi go on sale February 26","summary":"The semifinals take place on May 23 before the third-place game and championship game on May 25"},"linkedIds":[{"text":"Euroleague","sourceSystem":"FS_BASKETBALL_COMPETITION","sourceSystemId":"E"},{"text":"ALBA Berlin","sourceSystem":"FS_BASKETBALL_TEAM","sourceSystemId":"BER"},{"text":"Anadolu Efes Istanbul","sourceSystem":"FS_BASKETBALL_TEAM","sourceSystemId":"IST"},{"text":"AS Monaco","sourceSystem":"FS_BASKETBALL_TEAM","sourceSystemId":"MCO"},{"text":"Baskonia Vitoria-Gasteiz","sourceSystem":"FS_BASKETBALL_TEAM","sourceSystemId":"BAS"},{"text":"Crvena Zvezda Meridianbet Belgrade","sourceSystem":"FS_BASKETBALL_TEAM","sourceSystemId":"RED"},{"text":"EA7 Emporio Armani Milan","sourceSystem":"FS_BASKETBALL_TEAM","sourceSystemId":"MIL"},{"text":"FC Barcelona","sourceSystem":"FS_BASKETBALL_TEAM","sourceSystemId":"BAR"},{"text":"FC Bayern Munich","sourceSystem":"FS_BASKETBALL_TEAM","sourceSystemId":"MUN"},{"text":"Fenerbahce Beko Istanbul","sourceSystem":"FS_BASKETBALL_TEAM","sourceSystemId":"ULK"},{"text":"LDLC ASVEL Villeurbanne","sourceSystem":"FS_BASKETBALL_TEAM","sourceSystemId":"ASV"},{"text":"Maccabi Playtika Tel Aviv","sourceSystem":"FS_BASKETBALL_TEAM","sourceSystemId":"TEL"},{"text":"Olympiacos Piraeus","sourceSystem":"FS_BASKETBALL_TEAM","sourceSystemId":"OLY"},{"text":"Panathinaikos AKTOR Athens","sourceSystem":"FS_BASKETBALL_TEAM","sourceSystemId":"PAN"},{"text":"Paris Basketball","sourceSystem":"FS_BASKETBALL_TEAM","sourceSystemId":"PRS"},{"text":"Partizan Mozzart Bet Belgrade","sourceSystem":"FS_BASKETBALL_TEAM","sourceSystemId":"PAR"},{"text":"Real Madrid","sourceSystem":"FS_BASKETBALL_TEAM","sourceSystemId":"MAD"},{"text":"Virtus Segafredo Bologna","sourceSystem":"FS_BASKETBALL_TEAM","sourceSystemId":"VIR"},{"text":"Zalgiris Kaunas","sourceSystem":"FS_BASKETBALL_TEAM","sourceSystemId":"ZAL"},{"sourceSystem":"FS_BASKETBALL_SEASON","sourceSystemId":"E2024"},{"sourceSystem":"MEDIA","sourceSystemId":"2ebba550-c730-48fb-aa4a-61fc7944507a"}],"readTimeMinutes":2,"auth":{"loginRequired":null,"roles":[],"entitlements":[]},"content":[{"id":"2be3a4fe-5a89-47db-82cf-42c9ef40affd","contentType":"TEXT","text":"For the first time ever, the Turkish Airlines EuroLeague Final Four [will be held in Abu Dhabi at the state-of-the-art Etihad Arena](https://www.euroleaguebasketball.net/en/euroleague/news/abu-dhabi-to-host-2025-turkish-airlines-euroleague-final-four/) from May 23 to May 25, 2025. Basketball fans will have the opportunity to witness the thrilling conclusion of Europe’s top club competition.\n\nTickets officially go on sale on February 26 at 09:00 CET (12:00 ADT), giving fans the chance to experience the unique atmosphere of Europe’s premier club basketball showdown in Abu Dhabi. All ticket information and sales will be available exclusively online at [www.f4tickets.com](http://www.f4tickets.com) and Abu Dhabi Event Tickets in Etihad Arena.\n\nAs in previous seasons, a pre-sale window will open on Tuesday, February 25, for season ticket holders of EuroLeague clubs who participate in this initiative, EuroLeague TV subscribers, and previous Final Four ticket purchasers.\n\n### World-class basketball in a premier destination\n\nThe 2025 EuroLeague Final Four will bring its signature excitement to Abu Dhabi, a global hub for world-class sporting events known for its passionate basketball fans, cutting-edge infrastructure, vibrant culture, and unique attractions. The Etihad Arena, located on the city’s entertainment hub of Yas Island, will provide the perfect stage for the competition.\n\nThe Final Four will start on Friday, May 23, with semifinal showdowns taking place at 19:00 and 22:00 local time, while the EuroLeague Third-Place Game will tip off on Sunday at 18:00 local time, before the EuroLeague Championship Game takes center stage at 21:00 local time, with one team set to become the 2024-25 EuroLeague champion.\n\n### Ticketing options\n\nGeneral public tickets provide access to all four games (two on Friday and two on Sunday) and are available in the following price categories, ranging from €74.75 per game (€299 total) to €187.25 per game (€749 total).\n\nAlso, VIP hospitality packages and ticket + hotel bundles will be available starting February 26, offering fans and businesses exclusive benefits to enhance their Final Four experience. Full details are available at [www.f4tickets.com](http://www.f4tickets.com). For further inquiries, please contact [f4tickets@euroleague.net](mailto:f4tickets@euroleague.net).\n\nDon’t miss your chance to witness one of the biggest sporting events of the year in Abu Dhabi, the home of basketball in the Middle East!","isHtml":false,"sponsor":null}],"categories":[{"text":"Euroleague Configuration","id":"29324d1a-5925-4440-984b-fde4d1edce63"},{"text":"Homepage Hero","id":"d89d023f-da48-4b20-b7ec-5c8198e50336"},{"text":"News Hero","id":"1ddb1957-6591-485a-9ab1-eec43ec269af"},{"text":"Euroleague News","id":"dd63261c-b945-4737-b3fb-ff56300747d0"},{"text":"Article","id":"2291d04f-de2b-4fa8-9755-219db77bf5da"},{"text":"Final Four","id":"814cab4a-6e9e-4667-ac8f-647704dc4fa3"},{"text":"Euroleague Basketball Configuration","id":"4df18cf1-669c-4a4a-9ab5-44788d5028ff"},{"text":"Featured Top","id":"b5ce4c03-480b-417a-a0eb-f11a401de1d3"},{"text":"Seasons","id":"2337e0ea-a3c8-488e-b338-5fdc76cb933b"},{"text":"2024-25","id":"cc30def9-6c88-4134-9de4-61b376c34c42"}],"language":"en","localisedVersions":[],"articleMetadata":{"title":"Tickets for the 2025 EuroLeague Final Four in Abu Dhabi go on sale February 26!","description":"Tickets for the 2025 EuroLeague Final Four in Abu Dhabi officially go on sale on February 26 at 09:00 CET (12:00 ADT), giving fans the chance to experience the unique atmosphere of Europe’s premier club basketball showdown.","ogTitle":null,"ogDescription":null,"ogType":null,"ogImageUrl":null,"twitterCard":null,"twitterSite":null,"twitterCreator":null}},"theme":"Light","orientation":"Landscape"},"homepageLandingHero":{"heroArticle":{"pageType":"Article","generatedUrl":"/en/euroleague/news/mike-james-everyday-guy-alpha-diallo-starred-for-monaco-in-piraeus/","id":"ae6dc852-90e7-4e3a-8bed-9371fe04b908","publishDate":"2025-10-30T00:02:19.047Z","lastModified":"2025-10-30T02:08:50.535Z","displayCategory":{"id":"76b004d5-fa1c-4e2e-9f81-74449f209637","text":"Game Report"},"author":{"name":"Igor Petrinovic","title":"Euroleague.net","imageUrl":null,"socialHandles":[{"provider":"TWITTER","handle":"@IgorPetrinovic","link":"https://x.com/IgorPetrinovic"}]},"slug":"mike-james-everyday-guy-alpha-diallo-starred-for-monaco-in-piraeus","heroMedia":{"content":{"contentType":"IMAGE","image":"https://media-cdn.cortextech.io/42f1ab59-90e3-4f7a-b5c4-be8665cc865c.jpg?crop=1350%3A760%3Anowe%3A0%3A123","title":null,"description":""},"title":"Mike James, ‘everyday guy’ Alpha Diallo starred for Monaco in Piraeus","summary":"For the second year in a row, Monaco scored a valuable road win at Olympiacos "},"linkedIds":[{"text":"Euroleague","sourceSystem":"FS_BASKETBALL_COMPETITION","sourceSystemId":"E"},{"sourceSystem":"FS_BASKETBALL_SEASON","sourceSystemId":"E2025"},{"text":"Olympiacos Piraeus","sourceSystem":"FS_BASKETBALL_TEAM","sourceSystemId":"OLY"},{"text":"Olympiacos Piraeus v AS Monaco (2025-10-29T19:15:00.000Z)","sourceSystem":"FS_BASKETBALL_MATCH","sourceSystemId":"70"},{"text":"AS Monaco","sourceSystem":"FS_BASKETBALL_TEAM","sourceSystemId":"MCO"},{"text":"DIALLO, ALPHA","sourceSystem":"FS_BASKETBALL_PLAYER","sourceSystemId":"011226"},{"text":"JAMES, MIKE","sourceSystem":"FS_BASKETBALL_PLAYER","sourceSystemId":"005985"},{"sourceSystem":"MEDIA","sourceSystemId":"42f1ab59-90e3-4f7a-b5c4-be8665cc865c"}],"readTimeMinutes":3,"auth":{"loginRequired":null,"roles":[],"entitlements":[]},"content":[{"id":"2726021a-4832-4a4c-be43-48cf5e657ebf","contentType":"GAME_STAT_COMPONENT","status":"Show"},{"id":"172f5031-8a4a-441c-a063-0daf5fcf8ec0","contentType":"TEXT","text":"It might still be too early in the season, but it feels as though [AS Monaco](https://www.euroleaguebasketball.net/euroleague/teams/as-monaco/mco/) made a statement on Wednesday night.\n\nOf course, it can be argued that being the reigning EuroLeague runner-up does free a team from needing to make statements in the first place, but Monaco made one nevertheless, going on the road and edging [Olympiacos Piraeus](https://www.euroleaguebasketball.net/euroleague/teams/olympiacos-piraeus/oly/) 87-92 in a hard-fought affair.\n\n“I think we played a really good game,” Monaco star guard and the EuroLeague’s all-time leading scorer [Mike James](https://www.euroleaguebasketball.net/euroleague/players/mike-james/005985/) said with a smile in a EuroLeague TV interview after the win.\n\nJames orchestrated things on the floor at the Peace and Friendship Stadium, playing 32 minutes and posting a double-double of 23 points and 10 assists. He shot 3 of 6 from long range, made 5 of 7 twos, and also had 4 rebounds.\n\nIt was his best performance of this young campaign, and he now sits in second place in the league in assists this season with 6.6 per game.\n\nHis performance, and the game’s outcome, came as a bit of *déjà vu*.","isHtml":false,"sponsor":null},{"id":"cd03aa99-2b02-484e-ad3a-33f2e8f1833e","contentType":"VIDEO","title":"Olympiacos Piraeus-AS Monaco | Round 7 Highlights | 2025-26 EuroLeague","description":null,"sourceSystem":"YOUTUBE","sourceSystemId":"Q6Gf3gowyFk","url":"https://www.youtube.com/watch?v=Q6Gf3gowyFk","thumbnail":"https://img.youtube.com/vi/Q6Gf3gowyFk/maxresdefault.jpg","sponsor":null,"showPreRoll":true},{"id":"d2bf6259-1ebf-45c4-abbe-c007d510b7eb","contentType":"TEXT","text":"This was a rematch of last season’s Final Four semifinals, in which James starred in Monaco’s win over the Reds in Abu Dhabi. But just like in that historic semifinal win, in this Round 7 affair in Piraeus, James had a sidekick – and just like in Abu Dhabi, there was that same other protagonist, [Alpha Diallo](https://www.euroleaguebasketball.net/euroleague/players/alpha-diallo/011226/), who pushed and pulled Monaco to victory once again.\n\nDiallo played 35 minutes and 17 seconds in this Round 7 clash, scoring a career-high 27 points. He made 8 of 9 twos and 3 of 4 threes, and chipped in 3 rebounds, 3 assists and 2 steals to his all-round effort.\n\nBoth players earned great praise from their head coach, Vassilis Spanoulis.\n\n“\\[Mike James\\] had 10 assists, but could have had more, we missed some open threes,” Spanoulis said. “Everybody knows he can score. He was very concentrated, he always made the right play.\n\n“Alpha played incredible,” Spanoulis continued. “You cannot judge Alpha from the points he scored. He plays incredible defense and in all the aspects of the game, that you cannot see on the stat sheet.”","isHtml":false,"sponsor":null},{"id":"0320363f-4c96-4bfa-9593-3eb3c78de0e1","contentType":"TEXT","text":"\u003ccenter\u003e\n\u003cblockquote class=\"twitter-tweet\"\u003e\u003cp lang=\"en\" dir=\"ltr\"\u003eBig game, big numbers! 🔥\u003ca href=\"https://twitter.com/hashtag/RocaTeam?src=hash\u0026amp;ref_src=twsrc%5Etfw\"\u003e#RocaTeam\u003c/a\u003e \u003ca href=\"https://twitter.com/hashtag/DagheMunegu?src=hash\u0026amp;ref_src=twsrc%5Etfw\"\u003e#DagheMunegu\u003c/a\u003e \u003ca href=\"https://t.co/FSTNmzUnkg\"\u003epic.twitter.com/FSTNmzUnkg\u003c/a\u003e\u003c/p\u003e\u0026mdash; AS Monaco Basket 🇲🇨 (@ASMonaco_Basket) \u003ca href=\"https://twitter.com/ASMonaco_Basket/status/1983650501943292064?ref_src=twsrc%5Etfw\"\u003eOctober 29, 2025\u003c/a\u003e\u003c/blockquote\u003e \u003cscript async src=\"https://platform.twitter.com/widgets.js\" charset=\"utf-8\"\u003e\u003c/script\u003e","isHtml":true,"sponsor":null},{"id":"a87a6916-666c-4c8f-91b7-8bb20280fe6e","contentType":"TEXT","text":"Diallo, playing in his fifth EuroLeague season, all with Monaco, is an all-out effort player who reads the game so well on both ends of the floor that he simply makes the team better.\n\nIn addition to his defensive prowess, after this 27-point performance, Diallo is now also averaging 14.3 points on 43.5% three-point shooting, turning himself in a nightmare for opposing defenses, too.\n\n“I just go out there and hoop every night, just to be an every-day guy,” Diallo tried to explain his approach on EuroLeague TV. “I try to come in, do the little stuff and just whatever it takes to win. I am happy I keep improving, it shows the work I’ve put in, and it is showing off.”\n\nThe win improved Monaco's record to 4-3, working like a charm after the team lost in its two previous road games, in Bologna against Virtus and in Sofia against Hapoel IBI Tel Aviv.\n\nThe next stop in just 48 hours is a home tilt against Panathinaikos AKTOR Athens.","isHtml":false,"sponsor":null},{"id":"199f0244-8beb-4ab3-b98d-af557e79275e","contentType":"RELATED_CONTENT","title":"Game News","relatedParameters":{"articleId":"ae6dc852-90e7-4e3a-8bed-9371fe04b908","relatedCategories":[],"specificContent":[],"tags":[],"linkedId":{"text":"Olympiacos Piraeus v AS Monaco (2025-10-29T19:15:00.000Z)","sourceSystem":"FS_BASKETBALL_MATCH","sourceSystemId":"70"}}},{"id":"d3132b66-1182-4c33-90cf-cdb687081f30","contentType":"GAME_LEADERS_COMPONENT","status":"Show"}],"categories":[{"text":"Euroleague News","id":"dd63261c-b945-4737-b3fb-ff56300747d0"},{"text":"Game Report","id":"76b004d5-fa1c-4e2e-9f81-74449f209637"},{"text":"Seasons","id":"2337e0ea-a3c8-488e-b338-5fdc76cb933b"},{"text":"2025-26","id":"d9570b85-5aff-4d8e-8515-fa05b83552a8"}],"language":"en","localisedVersions":[],"articleMetadata":{"title":"Mike James, ‘everyday guy’ Alpha Diallo starred for Monaco in Piraeus","description":"AS Monaco made a statement by going on the road and edging Olympiacos Piraeus 87-92 in a hard-fought affair in Round 7 of the 2025-26 EuroLeague Regular Season, with Mike James and Alpha Diallo playing key roles in the win.","ogTitle":null,"ogDescription":null,"ogType":null,"ogImageUrl":null,"twitterCard":null,"twitterSite":null,"twitterCreator":null}},"relatedArticles":[{"pageType":"Article","generatedUrl":"/en/euroleague/news/game-center-round-7-el2526/","id":"6387ce0e-8525-4c1a-a19d-1893dee30929","publishDate":"2025-10-29T16:46:15.589Z","lastModified":"2025-10-29T23:56:34.813Z","displayCategory":{"id":"2291d04f-de2b-4fa8-9755-219db77bf5da","text":"Article"},"author":{"name":"Euroleague.net Staff","title":null,"imageUrl":null,"socialHandles":[]},"slug":"game-center-round-7-el2526","heroMedia":{"content":{"contentType":"IMAGE","image":"https://media-cdn.cortextech.io/394e71cc-3cef-4f85-baa4-b2a214f1e961.jpg?crop=1350%3A760%3Anowe%3A0%3A63","title":null,"description":""},"title":"Game Center: Hapoel tops Partizan to remain in first; Monaco wins in Piraeus","summary":"The double-round action continues with six Round 8 games on Thursday"},"linkedIds":[{"text":"Olympiacos Piraeus v AS Monaco (2025-10-29T19:15:00.000Z)","sourceSystem":"FS_BASKETBALL_MATCH","sourceSystemId":"70"},{"text":"Hapoel IBI Tel Aviv v Partizan Mozzart Bet Belgrade (2025-10-29T18:00:00.000Z)","sourceSystem":"FS_BASKETBALL_MATCH","sourceSystemId":"69"},{"text":"Valencia Basket v Fenerbahce Beko Istanbul (2025-10-28T20:00:00.000Z)","sourceSystem":"FS_BASKETBALL_MATCH","sourceSystemId":"67"},{"text":"Paris Basketball v Anadolu Efes Istanbul (2025-10-28T19:45:00.000Z)","sourceSystem":"FS_BASKETBALL_MATCH","sourceSystemId":"66"},{"text":"FC Bayern Munich v Real Madrid (2025-10-28T19:00:00.000Z)","sourceSystem":"FS_BASKETBALL_MATCH","sourceSystemId":"64"},{"text":"FC Barcelona v EA7 Emporio Armani Milan (2025-10-28T19:30:00.000Z)","sourceSystem":"FS_BASKETBALL_MATCH","sourceSystemId":"63"},{"text":"Baskonia Vitoria-Gasteiz v Dubai Basketball (2025-10-28T19:30:00.000Z)","sourceSystem":"FS_BASKETBALL_MATCH","sourceSystemId":"61"},{"text":"Panathinaikos AKTOR Athens v Maccabi Rapyd Tel Aviv (2025-10-28T19:15:00.000Z)","sourceSystem":"FS_BASKETBALL_MATCH","sourceSystemId":"65"},{"text":"Zalgiris Kaunas v Virtus Bologna (2025-10-28T18:00:00.000Z)","sourceSystem":"FS_BASKETBALL_MATCH","sourceSystemId":"68"},{"text":"Crvena Zvezda Meridianbet Belgrade v LDLC ASVEL Villeurbanne (2025-10-28T18:00:00.000Z)","sourceSystem":"FS_BASKETBALL_MATCH","sourceSystemId":"62"},{"sourceSystem":"FS_BASKETBALL_SEASON","sourceSystemId":"E2025"},{"sourceSystem":"MEDIA","sourceSystemId":"394e71cc-3cef-4f85-baa4-b2a214f1e961"}],"readTimeMinutes":7,"auth":{"loginRequired":null,"roles":[],"entitlements":[]},"content":[{"id":"d947ced7-52d8-4dbf-a86e-c3dc35b1e8d2","contentType":"TEXT","text":"## Wednesday, October 29\n\n### [Hapoel IBI Tel Aviv 97-84 Partizan Mozzart Bet Belgrade](https://www.euroleaguebasketball.net/en/euroleague/game-center/2025-26/hapoel-ibi-tel-aviv-partizan-mozzart-bet-belgrade/E2025/69/)\n\nHapoel earned a well-deserved 97-84 win over Partizan after a smooth team effort saw as stack of home players finish in double figures, with the table-topping Israeli side improving to 6-1 while the Serbian outfit dropped to 3-4. Collin Malcolm paced Hapoel on 17 points, Dan Oturu netted 14 and Antonio Blakeney poured 13 while Chris Jones sank 12. Sterling Brown led the way for Partizan on 19 points and Duane Washington added 15.\n\nHapoel kept nosing ahead in a physical first quarter and forged a 25-19 lead after the opening 10 minutes, courtesy of late three-pointers from Malcolm and Blakeney, while Dylan Osetkowski carried Partizan as he netted 8 points. The visitors conjured a 0-11 run to turn the tide early in the second quarter as the introduction of Arijan Lakic and new signing Bruno Fernando beefed up its defense, leaving Hapoel scoreless for almost 5 minutes. However, the hosts responded with their own 10-0 streak and Hapoel came out on top, 43-42, in a rollercoaster first half. \n\nHapoel pulled away in the third quarter and carved out a 70-63 advantage ahead of the final 10 minutes on the back of a treble of three-pointers from Ish Wainright, giving the Israeli side its biggest lead of the night up to that point. Five unanswered points gave Hapoel a double-digit lead early in the fourth and there was no way back for Partizan after a pair of three-pointers from Chris Jones gave the home team an 83-69 lead midway through the period.","isHtml":false,"sponsor":null},{"id":"278d11ed-8d34-4743-beea-4bbde5ed6343","contentType":"TEXT","text":"\u003ccenter\u003e\n\u003cblockquote class=\"twitter-tweet\"\u003e\u003cp lang=\"iw\" dir=\"rtl\"\u003eהחיים זה לא שחור ולבן 🔺 \u003ca href=\"https://t.co/SDb2I8gOBu\"\u003epic.twitter.com/SDb2I8gOBu\u003c/a\u003e\u003c/p\u003e\u0026mdash; Hapoel Tel Aviv BC (@HapoelTLVBC) \u003ca href=\"https://twitter.com/HapoelTLVBC/status/1983626828985332108?ref_src=twsrc%5Etfw\"\u003eOctober 29, 2025\u003c/a\u003e\u003c/blockquote\u003e \u003cscript async src=\"https://platform.twitter.com/widgets.js\" charset=\"utf-8\"\u003e\u003c/script\u003e","isHtml":true,"sponsor":null},{"id":"f23c294d-80b3-4f51-bfd0-6088d08b878d","contentType":"TEXT","text":"### [Olympiacos Piraeus 87-92 AS Monaco](https://www.euroleaguebasketball.net/en/euroleague/game-center/2025-26/olympiacos-piraeus-as-monaco/E2025/70/)\n\nMonaco used the best scoring night of Alpha Diallo’s career and a double-double from Mike James to edge Olympiacos 87-92 in Round 7's Rivalry Series game on Wednesday night at the Peace and Friendship Stadium. \n\nIn the return of coach Vassilis Spanoulis to Piraeus, it was a defensive-minded Diallo who scored a career-best 27 points on 11-of-13 field-goal shooting, while James had 23 points and 10 assists as Monaco improved to a 4-3 record. Olympiacos also sits at 4-3 record after a loss in which Tyler Dorsey netted 23 points while Sasha Vezenkov scored 17 points.","isHtml":false,"sponsor":null},{"id":"264e491b-f480-444e-96b0-4a3efd91e446","contentType":"TEXT","text":"\u003ccenter\u003e\u003cblockquote class=\"twitter-tweet\"\u003e\u003cp lang=\"en\" dir=\"ltr\"\u003e🤯 WHAT A NIGHT! \u003ca href=\"https://twitter.com/hashtag/RocaTeam?src=hash\u0026amp;ref_src=twsrc%5Etfw\"\u003e#RocaTeam\u003c/a\u003e \u003ca href=\"https://twitter.com/hashtag/DagheMunegu?src=hash\u0026amp;ref_src=twsrc%5Etfw\"\u003e#DagheMunegu\u003c/a\u003e \u003ca href=\"https://t.co/aKiYn6sYtt\"\u003epic.twitter.com/aKiYn6sYtt\u003c/a\u003e\u003c/p\u003e\u0026mdash; AS Monaco Basket 🇲🇨 (@ASMonaco_Basket) \u003ca href=\"https://twitter.com/ASMonaco_Basket/status/1983650498386522517?ref_src=twsrc%5Etfw\"\u003eOctober 29, 2025\u003c/a\u003e\u003c/blockquote\u003e \u003cscript async src=\"https://platform.twitter.com/widgets.js\" charset=\"utf-8\"\u003e\u003c/script\u003e","isHtml":true,"sponsor":null},{"id":"a864ca75-5b38-42ae-addd-bed4d19f5e36","contentType":"TEXT","text":"## Tuesday, October 28\n\n### [Zalgiris Kaunas 86-65 Virtus Bologna](https://www.euroleaguebasketball.net/euroleague/game-center/2025-26/zalgiris-kaunas-virtus-bologna/E2025/68/)\n\nZalgiris held off a late charge from Virtus on Tuesday evening to grab an 86-65 win at Zalgirio Arena, with Sylvain Francisco running the show for the Lithuanian side. After getting off to a red-hot start, Zalgiris cooled off in the second and third quarters, which allowed Virtus to enter the final frame trailing by single digits. \n\nTwo Matt Morgan scores pulled Virtus within 4 points in the fourth, but Francisco stepped up once more by netting 13 fourth-quarter points and dishing 4 more assists to make things comfortable once again for Zalgiris, which won its second straight game. Tomas Masiulis’s men are now 5-2, while Dusko Ivanovic’s Virtus saw its three-game winning streak come to an end as it fell to 4-3. \n\nFrancisco had a 23-point, 10-assist double-double, and he was one of five Zalgiris players who scored in double digits. Moses Wright paired 14 points with 8 rebounds, Dustin Sleva netted 13 points, Deividas Sirvydis poured in 11, and Azuolas Tubelis finished with 10 points and 7 boards. For Virtus, Morgan scored 19 points and Alen Smailagic added 12. Carsen Edwards was held to just 9 points.","isHtml":false,"sponsor":null},{"id":"8ccf142b-14f7-46b3-8639-8ef6f8341bfd","contentType":"TEXT","text":"\u003ccenter\u003e\n\u003cblockquote class=\"twitter-tweet\"\u003e\u003cp lang=\"en\" dir=\"ltr\"\u003eA winning start to the \u003ca href=\"https://twitter.com/EuroLeague?ref_src=twsrc%5Etfw\"\u003e@EuroLeague\u003c/a\u003e double week! See you on Thursday in Zalgirio Arena! 🏠💚\u003cbr\u003e\u003cbr\u003e(Presented by: Go3) \u003ca href=\"https://t.co/syylQwAmey\"\u003epic.twitter.com/syylQwAmey\u003c/a\u003e\u003c/p\u003e\u0026mdash; BC Zalgiris Kaunas (@bczalgiris) \u003ca href=\"https://twitter.com/bczalgiris/status/1983262049473094093?ref_src=twsrc%5Etfw\"\u003eOctober 28, 2025\u003c/a\u003e\u003c/blockquote\u003e \u003cscript async src=\"https://platform.twitter.com/widgets.js\" charset=\"utf-8\"\u003e\u003c/script\u003e\n","isHtml":true,"sponsor":null},{"id":"d1d34639-b1e2-4cd7-b794-2c950462a502","contentType":"TEXT","text":"### [Crvena Zvezda Meridianbet Belgrade 79-65 LDLC ASVEL Villeurbanne](https://www.euroleaguebasketball.net/en/euroleague/game-center/2025-26/crvena-zvezda-meridianbet-belgrade-ldlc-asvel-villeurbanne/E2025/62/)\n\nCrvena Zvezda grabbed its fifth consecutive EuroLeague win by downing LDLC ASVEL Villeurbanne 79-65 in the Serbian capital on Tuesday. Zvezda improved to 5-2 in the standings and is 4-0 since Coach Sasa Obradovic joined the team. ASVEL dropped to 2-5 and is 0-3 on the road this season.\n\nChima Moneke paced the winners with 24 points on 8-of-8 two-point shooting, 7 rebounds and 3 steals for a PIR of 35. Semi Ojeleye and Ognjen Dobric each added 11 for Zvezda. Melvin Ajinca paced ASVEL with 13 points while Mbaye Ndiaye added 10. \n\nASVEL trailed 24-23 early in the second quarter before an outstanding Moneke fueled a 10-0 run that put Zvezda on the right track, 39-25, at halftime. The hosts managed to keep a double-digit lead throughout the second half to cruise to another victory.  ","isHtml":false,"sponsor":null},{"id":"1d410039-8ee1-4936-9622-57d2004f934a","contentType":"TEXT","text":"\u003ccenter\u003e\n\u003cblockquote class=\"twitter-tweet\"\u003e\u003cp lang=\"ru\" dir=\"ltr\"\u003eБРАВО ЗВЕЗДО 🌟\u003ca href=\"https://twitter.com/hashtag/kkcz?src=hash\u0026amp;ref_src=twsrc%5Etfw\"\u003e#kkcz\u003c/a\u003e \u003ca href=\"https://twitter.com/hashtag/WeAreTheTeam?src=hash\u0026amp;ref_src=twsrc%5Etfw\"\u003e#WeAreTheTeam\u003c/a\u003e \u003ca href=\"https://twitter.com/hashtag/EveryGameMatters?src=hash\u0026amp;ref_src=twsrc%5Etfw\"\u003e#EveryGameMatters\u003c/a\u003e | \u003ca href=\"https://twitter.com/sportmts?ref_src=twsrc%5Etfw\"\u003e@sportmts\u003c/a\u003e \u003ca href=\"https://t.co/XWlr5kTDem\"\u003epic.twitter.com/XWlr5kTDem\u003c/a\u003e\u003c/p\u003e\u0026mdash; KK Crvena zvezda Meridianbet (@kkcrvenazvezda) \u003ca href=\"https://twitter.com/kkcrvenazvezda/status/1983261706550681787?ref_src=twsrc%5Etfw\"\u003eOctober 28, 2025\u003c/a\u003e\u003c/blockquote\u003e \u003cscript async src=\"https://platform.twitter.com/widgets.js\" charset=\"utf-8\"\u003e\u003c/script\u003e","isHtml":true,"sponsor":null},{"id":"14f4197e-a742-408a-b4c3-7fc96a55260b","contentType":"TEXT","text":"### [FC Bayern Munich 90-84 Real Madrid](https://www.euroleaguebasketball.net/en/euroleague/game-center/2025-26/fc-bayern-munich-real-madrid/E2025/64/)\n\nFC Bayern Munich got back to winning ways by beating Real Madrid 90-84 on Tuesday night at SAP Garden. In a game of runs, the hosts started strong and took an early 13-2 lead. *Los Blancos* bounced back and went on a 2-15 surge in the second quarter to take a 44-57 cushion into the second half. \n\nBayern responded with a 13-3 spurt and outscored Real Madrid 25-10 in the third, securing a 69-67 edge with 10 minutes to go. The German side hit the ground running again in the fourth and took an 82-72 lead with 6 minutes left. Real Madrid fought back in the closing stages, but the hosts absorbed its last comeback attempt. Bayern improved to 3-4, with the Spanish side dropping to the same record following their fourth straight defeat.\n\nIsiaha Mike netted a career-high 29 points for the winners, with Xavier Rathan-Mayes scoring 14 against his former team and Oscar da Silva completing a double-double of 10 points and 10 rebounds. Trey Lyles paced Real Madrid with 20 points, while Theo Maledon and Walter Tavares scored 15 and 13, respectively.","isHtml":false,"sponsor":null},{"id":"32d98608-407b-42a6-92d3-87184a89864a","contentType":"TEXT","text":"\u003ccenter\u003e\n\u003cblockquote class=\"twitter-tweet\"\u003e\u003cp lang=\"en\" dir=\"ltr\"\u003eFINAL SCORE: LETS GOOOOO, BIG TIME W!\u003ca href=\"https://twitter.com/hashtag/FCBB?src=hash\u0026amp;ref_src=twsrc%5Etfw\"\u003e#FCBB\u003c/a\u003e \u003ca href=\"https://twitter.com/hashtag/WeBallTogether?src=hash\u0026amp;ref_src=twsrc%5Etfw\"\u003e#WeBallTogether\u003c/a\u003e \u003ca href=\"https://twitter.com/hashtag/BAYRMB?src=hash\u0026amp;ref_src=twsrc%5Etfw\"\u003e#BAYRMB\u003c/a\u003e \u003ca href=\"https://t.co/gVO2nx7Ylu\"\u003epic.twitter.com/gVO2nx7Ylu\u003c/a\u003e\u003c/p\u003e\u0026mdash; FC Bayern Basketball (@FCBBasketball) \u003ca href=\"https://twitter.com/FCBBasketball/status/1983278880577454105?ref_src=twsrc%5Etfw\"\u003eOctober 28, 2025\u003c/a\u003e\u003c/blockquote\u003e \u003cscript async src=\"https://platform.twitter.com/widgets.js\" charset=\"utf-8\"\u003e\u003c/script\u003e","isHtml":true,"sponsor":null},{"id":"6891d6a6-bf2b-4567-bba0-a53e6edbb92d","contentType":"TEXT","text":"### [Panathinaikos AKTOR Athens 99-85 Maccabi Rapyd Tel Aviv](https://www.euroleaguebasketball.net/en/euroleague/game-center/2025-26/panathinaikos-aktor-athens-maccabi-rapyd-tel-aviv/E2025/65/)\n\nPanathinaikos ground out a 99-85 home win over Maccabi in a spectacular clash as Kendrick Nunn shined for the home side with a game-high 22 points. Cedi Osman netted 20 and Omer Yurtseven added 16 to go with a career-high 13 rebounds. At the other end, Jaylen Hoard posted 15 points and 9 boards, while Jimmy Clark scored 14 points.\n\nIn a fast-paced start, Panathinaikos carved out a 15-9 lead on the back of 5 points from Osman as well as 4 each by Nunn and Yurtseven. The advantage soon soared to 22-14 as the fired-up Osman kept delivering for the hosts, but Maccabi turned the tide and was 24-25 ahead at the end of the first quarter as Clark netted from inside his own half on the buzzer. The high-scoring battle continued in the second quarter as both sides stayed prolific from long range, with Clark carrying Maccabi while Osman was unstoppable at the other end. Maccabi took a 47-49 lead into the locker room at halftime thanks to 12 points from Clark and 10 by Roman Sorkin.\n\nNunn kept Panathinaikos afloat in the third quarter as he caught fire from all over and the hosts flipped the script with a 9-0 streak to nose ahead 64-60 midway through. Panathinaikos was 68-66 in front ahead of the final 10 minutes, with 11 points in the third quarter. The home team took the game by the scruff of the neck in the final 10 minutes, engineering a 12-0 run to take an 83-71 lead and out the game beyond Maccabi’s reach.","isHtml":false,"sponsor":null},{"id":"c2964b6d-01c8-4600-a139-1aeb378fcbc5","contentType":"TEXT","text":"\u003ccenter\u003e\n\u003cblockquote class=\"twitter-tweet\"\u003e\u003cp lang=\"en\" dir=\"ltr\"\u003eFinal Score ☘️\u003ca href=\"https://twitter.com/hashtag/paobcaktor?src=hash\u0026amp;ref_src=twsrc%5Etfw\"\u003e#paobcaktor\u003c/a\u003e - \u003ca href=\"https://twitter.com/MaccabiTLVBC?ref_src=twsrc%5Etfw\"\u003e@MaccabiTLVBC\u003c/a\u003e 99-85\u003ca href=\"https://twitter.com/hashtag/WeTheGreens?src=hash\u0026amp;ref_src=twsrc%5Etfw\"\u003e#WeTheGreens\u003c/a\u003e \u003ca href=\"https://twitter.com/hashtag/Club1908?src=hash\u0026amp;ref_src=twsrc%5Etfw\"\u003e#Club1908\u003c/a\u003e \u003ca href=\"https://t.co/c2R7dCnsPU\"\u003epic.twitter.com/c2R7dCnsPU\u003c/a\u003e\u003c/p\u003e\u0026mdash; Panathinaikos BC (@Paobcgr) \u003ca href=\"https://twitter.com/Paobcgr/status/1983282252403663200?ref_src=twsrc%5Etfw\"\u003eOctober 28, 2025\u003c/a\u003e\u003c/blockquote\u003e \u003cscript async src=\"https://platform.twitter.com/widgets.js\" charset=\"utf-8\"\u003e\u003c/script\u003e","isHtml":true,"sponsor":null},{"id":"7974a642-be2a-434d-ab8e-743c02ed2951","contentType":"TEXT","text":"### [FC Barcelona 74-72 EA7 Emporio Armani Milan](https://www.euroleaguebasketball.net/en/euroleague/game-center/2025-26/fc-barcelona-ea7-emporio-armani-milan/E2025/63/)\n\nFC Barcelona held on to a dramatic 74-72 win over visiting EA7 Emporio Armani Milan on Tuesday night. Milan had the last possession, but all the visitors could do was see Shavon Shields come up short with a long three-point attempt, as Barcelona prevailed and improved its record to 4-3. Milan dropped to 2-5 on the season.\n\nPoints were few and far between in the fourth quarter, which Barcelona took by the score 11-10. When all was said and done, Will Clyburn finished as the top scorer with 17 points, Jan Vesely had 14 while Kevin Punter netted 13. Tomas Satoransky had 11 points and 7 assists in a victory. For the visitors, Armoni Brooks scored 12 of his 15 points in the first half, and Shields scored 12 in defeat.","isHtml":false,"sponsor":null},{"id":"8defa53d-9918-44ec-ad8b-d66359b4c39c","contentType":"TEXT","text":"\u003ccenter\u003e\n\u003cblockquote class=\"twitter-tweet\"\u003e\u003cp lang=\"ca\" dir=\"ltr\"\u003e𝐕𝐈𝐂𝐓𝐎̀𝐑𝐈𝐀 𝐃𝐄 𝐏𝐀𝐋𝐀𝐔. \u003ca href=\"https://t.co/ifFLRbE2s7\"\u003epic.twitter.com/ifFLRbE2s7\u003c/a\u003e\u003c/p\u003e\u0026mdash; Barça Basket (@FCBbasket) \u003ca href=\"https://twitter.com/FCBbasket/status/1983284223290269706?ref_src=twsrc%5Etfw\"\u003eOctober 28, 2025\u003c/a\u003e\u003c/blockquote\u003e \u003cscript async src=\"https://platform.twitter.com/widgets.js\" charset=\"utf-8\"\u003e\u003c/script\u003e","isHtml":true,"sponsor":null},{"id":"17d27374-0dbf-4d1f-8125-a02658cf4a82","contentType":"TEXT","text":"### [Baskonia Vitoria-Gasteiz 92-85 Dubai Basketball](https://www.euroleaguebasketball.net/en/euroleague/game-center/2025-26/baskonia-vitoria-gasteiz-dubai-basketball/E2025/61/)\n\nBaskonia Vitoria-Gasteiz finally tasted victory in the EuroLeague this season as it fought past Dubai Basketball 92-85 to start the double-round week. Baskonia used a 14-3 fourth quarter run to take a 15-point lead only to watch Dubai trim it to 3 points. But the Spanish side survived to improve to 1-6. \n\nTimothe Luwawu-Cabarrot led the way with 25 points - 22 of them coming in the second half - while Kobi Simmons scored 16 points and Hamidou Diallo added 14 points. Dubai fell to 3-4 including 1-4 on the road this season despite Filip Petrusev scoring 22 points. ","isHtml":false,"sponsor":null},{"id":"c3e4b1fb-b438-4228-a21d-96120a32af1e","contentType":"TEXT","text":"\u003ccenter\u003e\n\u003cblockquote class=\"twitter-tweet\"\u003e\u003cp lang=\"es\" dir=\"ltr\"\u003eFINAAAAL\u003cbr\u003e\u003cbr\u003eYa tenemos la primera de \u003ca href=\"https://twitter.com/EuroLeague?ref_src=twsrc%5Etfw\"\u003e@EuroLeague\u003c/a\u003e en casa💪 \u003ca href=\"https://t.co/Y0emgX6Chc\"\u003epic.twitter.com/Y0emgX6Chc\u003c/a\u003e\u003c/p\u003e\u0026mdash; Baskonia (@Baskonia) \u003ca href=\"https://twitter.com/Baskonia/status/1983287670928511383?ref_src=twsrc%5Etfw\"\u003eOctober 28, 2025\u003c/a\u003e\u003c/blockquote\u003e \u003cscript async src=\"https://platform.twitter.com/widgets.js\" charset=\"utf-8\"\u003e\u003c/script\u003e","isHtml":true,"sponsor":null},{"id":"fa992926-2460-438e-abc4-f3b0b7b9001c","contentType":"TEXT","text":"### [Paris Basketball 80-90 Anadolu Efes Istanbul](https://www.euroleaguebasketball.net/en/euroleague/game-center/2025-26/paris-basketball-anadolu-efes-istanbul/E2025/66/)\n\nEfes got back to winning on Tuesday night by downing Paris 80-90 on the road. The Turkish side – which had head coach Igor Kokoskov ejected for 2 quick technical fouls in the third quarter – held Paris to a season-low 39 first-half points and did a good job of keeping Nadir Hifi quiet throughout, with the French guard shooting 2 for 16 from the field. After back-to-back home losses in Rounds 5 and 6, Efes notched its second road win of the campaign to improve to 3-4. Paris, meanwhile, dropped to 4-3. \n\nShane Larkin led Efes with a game-high 19 points, while Ercan Osmani was the contest’s second-highest scorer with 18 points. Jordan Loyd and Isaia Cordinier added 14 points apiece, and Rolands Smits netted 11. Despite a torrid night from the field, Hifi made all 13 of his free throws en route to 17 points, the same total as Sebastian Herrera. Justin Robinson and Yakuba Ouattara poured in 13 points each.","isHtml":false,"sponsor":null},{"id":"5482041f-295f-4115-92ad-2fb4aca1e53f","contentType":"TEXT","text":"\u003ccenter\u003e\u003cblockquote class=\"twitter-tweet\"\u003e\u003cp lang=\"tr\" dir=\"ltr\"\u003e👊 Midnight in Paris!\u003cbr\u003eParis Basketball 80 - 90 Anadolu Efes | Maç Sonucu\u003ca href=\"https://twitter.com/hashtag/BenimYerimBuras%C4%B1?src=hash\u0026amp;ref_src=twsrc%5Etfw\"\u003e#BenimYerimBurası\u003c/a\u003e \u003ca href=\"https://t.co/P7X9cLPBuc\"\u003epic.twitter.com/P7X9cLPBuc\u003c/a\u003e\u003c/p\u003e\u0026mdash; Anadolu Efes SK (@AnadoluEfesSK) \u003ca href=\"https://twitter.com/AnadoluEfesSK/status/1983292259060817971?ref_src=twsrc%5Etfw\"\u003eOctober 28, 2025\u003c/a\u003e\u003c/blockquote\u003e \u003cscript async src=\"https://platform.twitter.com/widgets.js\" charset=\"utf-8\"\u003e\u003c/script\u003e\n","isHtml":true,"sponsor":null},{"id":"0c820906-0aff-4fbd-b4ec-379c30b9c574","contentType":"TEXT","text":"### [Valencia Basket 94-79 Fenerbahce Beko Istanbul](https://www.euroleaguebasketball.net/en/euroleague/game-center/2025-26/valencia-basket-fenerbahce-beko-istanbul/E2025/67/)\n\nValencia Basket sent a message that echoed all around the competition by downing defending champion Fenerbahce Beko Istanbul 94-79 at Roig Arena in Round 7 on Tuesday. Valencia improved to 4-3 in the standings while Fenerbahce dropped to 3-4. Valencia dominated the game from start to finish, leading 27-10 late in the first quarter and extending its margin to 47-23 to break it open.\n\nKameron Taylor led the winners with 17 points. Brancou Badio had 15, Jean Montero added 12 while Darius Thompson got 11 for Valencia. Tarik Biberovic paced Fenerbahce with 18 points, scoring 16 of those in the fourth quarter. Talen Horton-Tucker netted 16, Wade Baldwin had 13 while Scottie Wilbekin scored 11 for the visitors, who only rallied a bit once the outcome was clear.","isHtml":false,"sponsor":null},{"id":"b6a478b0-d4ab-438c-8403-d22a36f8347a","contentType":"TEXT","text":"\u003ccenter\u003e\n\u003cblockquote class=\"twitter-tweet\"\u003e\u003cp lang=\"es\" dir=\"ltr\"\u003eVAMOOOOOOOOOOOS 🧡\u003cbr\u003e\u003cbr\u003e¡¡Tenemos la cuarta en \u003ca href=\"https://twitter.com/hashtag/EuroLeague?src=hash\u0026amp;ref_src=twsrc%5Etfw\"\u003e#EuroLeague\u003c/a\u003e!! 🔥\u003cbr\u003e\u003cbr\u003e¡¡Qué ambiente, \u003ca href=\"https://twitter.com/RoigArena?ref_src=twsrc%5Etfw\"\u003e@RoigArena\u003c/a\u003e!!\u003cbr\u003e\u003cbr\u003e🏆 J7 \u003ca href=\"https://twitter.com/EuroLeague?ref_src=twsrc%5Etfw\"\u003e@EuroLeague\u003c/a\u003e\u003cbr\u003e🟠 \u003ca href=\"https://twitter.com/valenciabasket?ref_src=twsrc%5Etfw\"\u003e@valenciabasket\u003c/a\u003e 92\u003cbr\u003e🟡 \u003ca href=\"https://twitter.com/FBBasketbol?ref_src=twsrc%5Etfw\"\u003e@FBBasketbol\u003c/a\u003e 79\u003cbr\u003e🤝 \u003ca href=\"https://twitter.com/pamesaceramica?ref_src=twsrc%5Etfw\"\u003e@pamesaceramica\u003c/a\u003e \u003cbr\u003e\u003cbr\u003eMañana \u003ca href=\"https://twitter.com/EuroLeagueWomen?ref_src=twsrc%5Etfw\"\u003e@EuroLeagueWomen\u003c/a\u003e \u003cbr\u003ePasado \u003ca href=\"https://twitter.com/EuroLeague?ref_src=twsrc%5Etfw\"\u003e@EuroLeague\u003c/a\u003e \u003cbr\u003e\u003cbr\u003eSEGUIM!! 🧡 \u003ca href=\"https://t.co/gwhIIpUqux\"\u003epic.twitter.com/gwhIIpUqux\u003c/a\u003e\u003c/p\u003e\u0026mdash; Valencia Basket Club (@valenciabasket) \u003ca href=\"https://twitter.com/valenciabasket/status/1983294695154561027?ref_src=twsrc%5Etfw\"\u003eOctober 28, 2025\u003c/a\u003e\u003c/blockquote\u003e \u003cscript async src=\"https://platform.twitter.com/widgets.js\" charset=\"utf-8\"\u003e\u003c/script\u003e","isHtml":true,"sponsor":null}],"categories":[{"text":"Euroleague Configuration","id":"29324d1a-5925-4440-984b-fde4d1edce63"},{"text":"News Hero","id":"1ddb1957-6591-485a-9ab1-eec43ec269af"},{"text":"Euroleague News","id":"dd63261c-b945-4737-b3fb-ff56300747d0"},{"text":"Article","id":"2291d04f-de2b-4fa8-9755-219db77bf5da"},{"text":"Seasons","id":"2337e0ea-a3c8-488e-b338-5fdc76cb933b"},{"text":"2025-26","id":"d9570b85-5aff-4d8e-8515-fa05b83552a8"}],"language":"en","localisedVersions":[],"articleMetadata":{"title":"Game Center: Round 7","description":"Round 7 of the 2025-26 EuroLeague season is here. Check out the Game Center in order to see how the teams got on.","ogTitle":null,"ogDescription":null,"ogType":null,"ogImageUrl":null,"twitterCard":null,"twitterSite":null,"twitterCreator":null}}],"subHeroArticles":[{"pageType":"Article","generatedUrl":"/en/euroleague/news/pregame-quotes-round-8-el2526/","id":"dabe123b-4d41-45cc-b43b-a8d4ee72d260","publishDate":"2025-10-30T09:25:07.120Z","lastModified":"2025-10-30T09:25:06.816Z","displayCategory":{"id":"2291d04f-de2b-4fa8-9755-219db77bf5da","text":"Article"},"author":{"name":"Euroleague.net Staff","title":null,"imageUrl":null,"socialHandles":[]},"slug":"pregame-quotes-round-8-el2526","heroMedia":{"content":{"contentType":"IMAGE","image":"https://media-cdn.cortextech.io/2c2f9d30-f560-459c-a6c1-a523ae5b6510.jpg?crop=1080%3A608%3Anowe%3A177%3A100","title":null,"description":""},"title":"Pregame quotes, Round 8: 'The plan is for Spencer Dinwiddie to play'","summary":"Check out what the coaches and players are saying ahead of Round 8 of the 2025-26 EuroLeague season"},"linkedIds":[{"text":"Euroleague","sourceSystem":"FS_BASKETBALL_COMPETITION","sourceSystemId":"E"},{"sourceSystem":"FS_BASKETBALL_SEASON","sourceSystemId":"E2025"},{"text":"Partizan Mozzart Bet Belgrade v FC Barcelona (2025-10-31T19:30:00.000Z)","sourceSystem":"FS_BASKETBALL_MATCH","sourceSystemId":"80"},{"text":"Baskonia Vitoria-Gasteiz v Anadolu Efes Istanbul (2025-10-31T19:30:00.000Z)","sourceSystem":"FS_BASKETBALL_MATCH","sourceSystemId":"78"},{"text":"Olympiacos Piraeus v Hapoel IBI Tel Aviv (2025-10-31T19:15:00.000Z)","sourceSystem":"FS_BASKETBALL_MATCH","sourceSystemId":"79"},{"text":"AS Monaco v Panathinaikos AKTOR Athens (2025-10-31T18:00:00.000Z)","sourceSystem":"FS_BASKETBALL_MATCH","sourceSystemId":"77"},{"text":"Real Madrid v Fenerbahce Beko Istanbul (2025-10-30T20:00:00.000Z)","sourceSystem":"FS_BASKETBALL_MATCH","sourceSystemId":"74"},{"text":"Valencia Basket v Dubai Basketball (2025-10-30T19:30:00.000Z)","sourceSystem":"FS_BASKETBALL_MATCH","sourceSystemId":"75"},{"text":"FC Bayern Munich v Virtus Bologna (2025-10-30T19:30:00.000Z)","sourceSystem":"FS_BASKETBALL_MATCH","sourceSystemId":"72"},{"text":"EA7 Emporio Armani Milan v Paris Basketball (2025-10-30T19:30:00.000Z)","sourceSystem":"FS_BASKETBALL_MATCH","sourceSystemId":"71"},{"text":"Maccabi Rapyd Tel Aviv v Crvena Zvezda Meridianbet Belgrade (2025-10-30T19:05:00.000Z)","sourceSystem":"FS_BASKETBALL_MATCH","sourceSystemId":"73"},{"text":"Zalgiris Kaunas v LDLC ASVEL Villeurbanne (2025-10-30T18:00:00.000Z)","sourceSystem":"FS_BASKETBALL_MATCH","sourceSystemId":"76"},{"sourceSystem":"MEDIA","sourceSystemId":"2c2f9d30-f560-459c-a6c1-a523ae5b6510"},{"sourceSystem":"MEDIA","sourceSystemId":"8e716e5f-c7bb-4984-a43a-e9b21a808d10"},{"sourceSystem":"MEDIA","sourceSystemId":"13061e00-a4f1-45ab-8bc1-6f5ae08002a9"},{"sourceSystem":"MEDIA","sourceSystemId":"07d06bcf-5a28-4b99-a4ab-8517b48216b2"},{"sourceSystem":"MEDIA","sourceSystemId":"ed73e4ad-0611-48e7-a693-2a39eef37f97"},{"sourceSystem":"MEDIA","sourceSystemId":"9fa024a1-8b34-4383-84ae-c6efa58e3580"}],"readTimeMinutes":8,"auth":{"loginRequired":null,"roles":[],"entitlements":[]},"content":[{"id":"cd6c7cb9-20f8-4057-969d-f6b12e37e357","contentType":"TEXT","text":"## Thursday, October 30\n\n### Zalgiris Kaunas vs. LDLC ASVEL Villeurbanne (19:00 CET)\n\n\\--\n\n### Maccabi Rapyd Tel Aviv vs. Crvena Zvezda Meridianbet Belgrade (20:05 CET)\n\n**Oded Kattash, Maccabi head coach**\n\n\"Crvena Zvezda is a team in excellent momentum, with their consecutive wins. They’re playing with a lot of confidence right now, especially with a stretch of home games that helped them build that momentum. They’re a very aggressive team, one that attacks the offensive rebounds. We’ll need to come out aggressive and control the boards — that’s something very important for us.\"\n\n**Sasa Obradovic, Crvena Zvezda head coach**\n\n\"This team knows how to play collectively, the players have been there for several years and they understand each other very well, so they have continuity of unity, which is a threat. They will be even better over time, we are in a specific situation, we know what an away win means, it would be a big win. We are in a situation where we need the integration of injured players and new players, but all of that can also disrupt us.\"\n\n**Stefan Miljenovic, Crvena Zvezda guard**\n\n\"A dangerous and difficult team. It's a strange feeling that we are playing in Pionir as guests. We will also have the support of our fans. We have to stop their individuals, the biggest threat is certainly Lonnie Walker.\"","isHtml":false,"sponsor":null},{"id":"43ee0450-8b02-4f2c-bd85-69689c6c63f6","contentType":"IMAGE","url":"https://media-cdn.cortextech.io/8e716e5f-c7bb-4984-a43a-e9b21a808d10.jpg?crop=1219%3A686%3Anowe%3A26%3A11","alt":null,"caption":null,"title":null,"thumbnail":null,"sponsor":null,"link":null},{"id":"6aa8c255-2d1b-4a90-8652-97b6f50efa35","contentType":"TEXT","text":"### FC Bayern Munich vs. Virtus Bologna (20:30 CET)\n\n**Gordon Herbert, Bayern head coach**\n\n\"It's the same scenario as last season; back then, they also came to us after a loss in Kaunas. We have to keep that in mind. Bologna has enough quality to bounce back—they’ve already claimed big wins over Panathinaikos, Monaco, and even Real. Our really strong performance against Real won’t mean much if we can’t repeat it against Bologna. Carsen Edwards had a great year for this club. It’s good to see him back at SAP Garden on Thursday. The plan is for Spencer \\[Dinwiddie\\] to play on Thursday. But we’ll only make the final decision shortly before the game, once we know how things stand with him and the team.\"\n\n**Dusko Ivanovic, Virtus head coach**\n\n\"In the game against Zalgiris, the way we started and the way we finished the game is absolutely not what we want. We need to improve on many things, but especially on this aspect, and tomorrow we will have another opportunity to do so. We will play against a team that beat Real Madrid here at home in the last EuroLeague round: they are an excellent team, they play well, and we will have to do our best to redeem ourselves.\"\n\n**Alessandro Pajola, Virtus guard**\n\n\"We're approaching this game with the desire to redeem ourselves after the Kaunas match: we'll need to approach the game much better, trying to limit turnovers and playing as a team in offense. Bayern are coming off a home win against Real Madrid, so we'll also need to be good at managing an electric atmosphere after their last game.\"","isHtml":false,"sponsor":null},{"id":"d4a7ea3b-3cd4-4384-868f-ff0b37a20710","contentType":"IMAGE","url":"https://media-cdn.cortextech.io/13061e00-a4f1-45ab-8bc1-6f5ae08002a9.jpg?crop=1080%3A607%3Anowe%3A135%3A65","alt":null,"caption":null,"title":null,"thumbnail":null,"sponsor":null,"link":null},{"id":"48783fa0-52a9-41ac-ac0e-b3b872698099","contentType":"TEXT","text":"### Valencia Basket vs. Dubai Basketball (20:30 CET)\n\n**Darius Thompson, Valencia guard**\n\n\"This is a difficult season for all teams. No one is really safe against anyone. You go out there every night and try to do your best and see how far you can go each day. Because anyone can beat anyone or be beaten by anyone. So you don't really look at each opponent thinking they're better or worse than another team. You just go out there and give it your best shot. We got the win last night and we'll try to do the same on Thursday.\"\n\n**Nate Reuvers, Valencia forward**\n\n\"In this competition, every game is really tough; there are no easy games. It's great to have the fans here at home; they give us energy. We're up against a very talented team. We have to do what we can to play our style, play our way. If we can do that, we'll have a chance to win. They have good inside players, so we have to give it our best again tomorrow and try to get the win. I feel really good so far. It's the same system as last season. So I feel like I'm continuing to develop and improve every year. And I'm also feeling more comfortable with the team. I think we have a great team this year. And confidence is key.\"","isHtml":false,"sponsor":null},{"id":"de3a269d-6ece-4a0d-a16a-76a9d3b06c5c","contentType":"IMAGE","url":"https://media-cdn.cortextech.io/07d06bcf-5a28-4b99-a4ab-8517b48216b2.jpg?crop=1251%3A704%3Anowe%3A86%3A53","alt":null,"caption":null,"title":null,"thumbnail":null,"sponsor":null,"link":null},{"id":"805dadd8-075a-4d0b-88a5-09a3f7e8d7f6","contentType":"TEXT","text":"### EA7 Emporio Armani Milan vs. Paris Basketball (20:30 CET)\n\n**Ettore Messina, Milan head coach**\n\n\"Paris Basketball is a team with great athleticism and speed, playing at the highest tempo in the EuroLeague, a team that tries to elevate the number of possessions. Taking care of the defensive transition and, above all, of the great energy that they have attacking the offensive board, with all five players, will be crucial to win this game, along with continuing to move the ball quickly on offense, balancing shots from inside and outside the right way.\"","isHtml":false,"sponsor":null},{"id":"5e4348a7-983f-4ccf-b1c3-a1b8eb321866","contentType":"IMAGE","url":"https://media-cdn.cortextech.io/ed73e4ad-0611-48e7-a693-2a39eef37f97.jpg?crop=1080%3A607%3Anowe%3A108%3A44","alt":null,"caption":null,"title":null,"thumbnail":null,"sponsor":null,"link":null},{"id":"1f8ab690-56fd-4984-b2b8-3d9e6e78c67f","contentType":"TEXT","text":"### Real Madrid vs. Fenerbahce Beko Istanbul (21:00 CET)\n\n**Sergio Scariolo, Real Madrid head coach**\n\n\"We're facing a very demanding doubleheader. The first thing we've worked on is recovering from yesterday's game, especially mentally. Now we're facing the Euroleague champions, a team of the highest quality, physically imposing, with great physical strength and a lot of scoring talent. We have to be able to turn the page, take the court with determination, and, above all, maintain that determination throughout the game with the help of our fans, who have always supported us in our home games and have always left happy with their team's victory.\"\n\n**Walter Tavares, Real Madrid center**\n\n\"Fenerbahçe is a very difficult opponent as they are the reigning EuroLeague champions. They are a well-established, experienced team that knows how to win. Real Madrid vs. Fenerbahçe is a classic, a very exciting game, but also a very difficult one, and we are going to try to do what we are doing well, which is to protect our home court with our fans. We have to be ready at all times because it will be a 40-minute game. If we play one or two bad quarters, it will be very difficult to win because Fenerbahçe is a team that knows how to manage the pace, and it will be very tough for us. We have to be in the game for the full 40 minutes.\"\n\n**Sarunas Jasikevicius, Fenerbahce head coach**\n\n\"Well, first of all, in Madrid, we want to see the reaction from us. We want to see a better defensive performance. Madrid will come after the loss very motivated, and we need to match that intensity and really focus on many post-up situations for their frontcourt players and the creation of Campazzo.\"\n\n**Nicolo Melli, Fenerbahce forward**\n\n\"It's going to be, for sure, a very tough game. We're both coming from a loss. Playing against Real Madrid is always a special game. It's, I would say, already a must-win game. I think it's going to be tough. We need to recover energy after this tough game and try our best to win the game.\"","isHtml":false,"sponsor":null},{"id":"b9d1e5a7-5f91-48c7-9a60-7864092ed6e4","contentType":"IMAGE","url":"https://media-cdn.cortextech.io/9fa024a1-8b34-4383-84ae-c6efa58e3580.jpg?crop=1289%3A725%3Anowe%3A0%3A59","alt":null,"caption":null,"title":null,"thumbnail":null,"sponsor":null,"link":null},{"id":"a1b51bf5-cf3b-4d7a-8ab1-7335a16eea02","contentType":"TEXT","text":"## Friday, October 31\n\n### AS Monaco vs. Panathinaikos AKTOR Athens (19:00 CET)\n\n\\--\n\n### Olympiacos Piraeus vs. Hapoel IBI Tel Aviv (20:15 CET)\n\n\\--\n\n### Partizan Mozzart Bet Belgrade vs. FC Barcelona (20:30 CET)\n\n\\--\n\n### Baskonia Vitoria-Gasteiz vs. Anadolu Efes Istanbul (20:30 CET)\n\n\\--","isHtml":false,"sponsor":null}],"categories":[{"text":"Euroleague News","id":"dd63261c-b945-4737-b3fb-ff56300747d0"},{"text":"Article","id":"2291d04f-de2b-4fa8-9755-219db77bf5da"},{"text":"Seasons","id":"2337e0ea-a3c8-488e-b338-5fdc76cb933b"},{"text":"2025-26","id":"d9570b85-5aff-4d8e-8515-fa05b83552a8"}],"language":"en","localisedVersions":[],"articleMetadata":{"title":"Pregame quotes hub: Round 8","description":"Check out what the coaches and players are saying ahead of Round 8 of the 2025-26 EuroLeague season.","ogTitle":null,"ogDescription":null,"ogType":null,"ogImageUrl":null,"twitterCard":null,"twitterSite":null,"twitterCreator":null}},{"pageType":"Article","generatedUrl":"/en/euroleague/news/injury-report-round-8-el2526/","id":"07d8e850-9f70-44b0-9611-55347eee9915","publishDate":"2025-10-29T23:47:42.684Z","lastModified":"2025-10-30T08:57:15.956Z","displayCategory":{"id":"2291d04f-de2b-4fa8-9755-219db77bf5da","text":"Article"},"author":{"name":"Euroleague.net Staff","title":null,"imageUrl":null,"socialHandles":[]},"slug":"injury-report-round-8-el2526","heroMedia":{"content":{"contentType":"IMAGE","image":"https://media-cdn.cortextech.io/cc720ad6-4794-4d0a-9f7b-369345502a79.jpg?crop=2028%3A1141%3Anowe%3A0%3A154","title":null,"description":""},"title":"Injury report, Round 8: Calathes, Dinwiddie, Butler all registered and available","summary":"Stay up to date with the latest information provided by the EuroLeague clubs"},"linkedIds":[{"text":"Euroleague","sourceSystem":"FS_BASKETBALL_COMPETITION","sourceSystemId":"E"},{"sourceSystem":"FS_BASKETBALL_SEASON","sourceSystemId":"E2025"},{"text":"Partizan Mozzart Bet Belgrade v FC Barcelona (2025-10-31T19:30:00.000Z)","sourceSystem":"FS_BASKETBALL_MATCH","sourceSystemId":"80"},{"text":"Baskonia Vitoria-Gasteiz v Anadolu Efes Istanbul (2025-10-31T19:30:00.000Z)","sourceSystem":"FS_BASKETBALL_MATCH","sourceSystemId":"78"},{"text":"Olympiacos Piraeus v Hapoel IBI Tel Aviv (2025-10-31T19:15:00.000Z)","sourceSystem":"FS_BASKETBALL_MATCH","sourceSystemId":"79"},{"text":"AS Monaco v Panathinaikos AKTOR Athens (2025-10-31T18:00:00.000Z)","sourceSystem":"FS_BASKETBALL_MATCH","sourceSystemId":"77"},{"text":"Real Madrid v Fenerbahce Beko Istanbul (2025-10-30T20:00:00.000Z)","sourceSystem":"FS_BASKETBALL_MATCH","sourceSystemId":"74"},{"text":"Valencia Basket v Dubai Basketball (2025-10-30T19:30:00.000Z)","sourceSystem":"FS_BASKETBALL_MATCH","sourceSystemId":"75"},{"text":"FC Bayern Munich v Virtus Bologna (2025-10-30T19:30:00.000Z)","sourceSystem":"FS_BASKETBALL_MATCH","sourceSystemId":"72"},{"text":"EA7 Emporio Armani Milan v Paris Basketball (2025-10-30T19:30:00.000Z)","sourceSystem":"FS_BASKETBALL_MATCH","sourceSystemId":"71"},{"text":"Maccabi Rapyd Tel Aviv v Crvena Zvezda Meridianbet Belgrade (2025-10-30T19:05:00.000Z)","sourceSystem":"FS_BASKETBALL_MATCH","sourceSystemId":"73"},{"text":"Zalgiris Kaunas v LDLC ASVEL Villeurbanne (2025-10-30T18:00:00.000Z)","sourceSystem":"FS_BASKETBALL_MATCH","sourceSystemId":"76"},{"sourceSystem":"MEDIA","sourceSystemId":"cc720ad6-4794-4d0a-9f7b-369345502a79"}],"readTimeMinutes":18,"auth":{"loginRequired":null,"roles":[],"entitlements":[]},"content":[{"id":"ff897220-750b-4150-bcc7-9274aaf0182a","contentType":"TEXT","text":"Follow all the latest injury information for registered players in the 2025-26 EuroLeague Regular Season, as reported by the clubs, and get your [EuroLeague Fantasy Challenge](https://euroleaguefantasy.euroleaguebasketball.net/en/home?_ga=2.101462721.1199459303.1696273873-903329349.1669636775) teams up to date!\n\n### Anadolu Efes Istanbul\n\nEfes has not yet sent an injury report for its game at Baskonia on Friday.\n\n- [Georgios Papagiannis is expected to miss eight months](https://www.euroleaguebasketball.net/euroleague/news/efes-ercan-osmani-out-three-weeks-georgios-papagiannis-to-miss-eight-months/) following ACL surgery, the club confirmed on October 18.\n- Vincent Poirier is out for [4-6 months after knee surgery](https://www.euroleaguebasketball.net/en/euroleague/news/efes-timetable-for-poiriers-return-set-at-4-6-months/).\n\n### AS Monaco\n\nMonaco has not yet sent an injury report for its game against Panathinaikos on Friday.\n\n- Yoan Makoundou missed Monaco's first seven games, but he has returned to training.\n\n### Baskonia Vitoria-Gasteiz\n\nBaskonia has not yet sent an injury report for its game against Efes on Friday.\n\n- [Trent Forrest (hamstring) and Markus Howard (finger) are sidelined for 'several weeks'](https://www.euroleaguebasketball.net/en/euroleague/news/baskonia-trent-forrest-markus-howard-sidelined-for-several-weeks/), the club announced on October 17.\n\n### Crvena Zvezda Meridianbet Belgrade\n\nJordan Nwora is doubtful while Devonte' Graham, Tyson Carter, Jasiel Rivero, Isaiah Canaan and Joel Bolomboy are all ruled out for Crvena Zvezda's game at Maccabi on Thursday, the club has confirmed.\n\n- [New signing Jared Butler](https://www.euroleaguebasketball.net/en/euroleague/news/jared-butler-is-belgrade-bound-after-signing-with-crvena-zvezda/) has been registered and is in line to make his debut in Round 8.\n- Jordan Nwora did not play in Round 7, but the club is [doing everything possible to get him ready for Round 8](https://x.com/kkcrvenazvezda/status/1983176287544848784).\n- Devonte' Graham has been unavailable so far this season due to a bone bruise, but [he has received clearance to rejoin first-team training](https://x.com/kkcrvenazvezda/status/1983176287544848784). He will be available to Coach Obradovic as soon as he recovers from a cold and high fever.\n- Tyson Carter has been [diagnosed with pulmonary embolism](https://www.euroleaguebasketball.net/en/euroleague/news/zvezdas-tyson-carter-facing-extended-absence-with-pulmonary-embolism/) and faces a lengthy absence.\n- Jasiel Rivero hurt his foot in Round 1 and is expected to be sidelined for several months.\n- Isaiah Canaan [suffered an ACL injury](https://www.euroleaguebasketball.net/en/euroleague/news/crvena-zvezda-loses-isaiah-canaan-to-acl-injury/) and is out long term.\n- Joel Bolomboy is out long term.\n\n### Dubai Basketball\n\nDubai has not yet sent an injury report for its game at Valencia on Thursday.\n\n- New signing [Boogie Ellis](https://www.euroleaguebasketball.net/euroleague/news/dubai-basketball-seals-move-for-boogie-ellis/) was on the game-day roster in Rounds 6 and 7, but did not make his debut.\n- Nemanja Dangubic has not featured since Round 4.\n- Kenan Kamenjas has not featured since Round 5.\n- Dzanan Musa and Aleksa Avramovic have sustained minor knee injuries and will be re-evaluated in the coming weeks, the club announced two weekends' ago.\n- Nate Mason has sustained a cervical disc injury and will continue to be monitored over the coming weeks, the club announced.\n- Summer signing Mam Jaiteh suffered an Achilles injury and will be sidelined for the remainder of the season.\n\n### EA7 Emporio Armani Milan\n\nZach LeDay, Lorenzo Brown, Josh Nebo and Ousmane Diop are all ruled out for Milan's game against Paris on Thursday, the club has confirmed.\n\n- Ousmane Diop last played in Round 5.\n\n- Lorenzo Brown last played in Round 4 due to a calf injury.\n\n- Zach LeDay last played in Round 3.\n\n- [Josh Nebo](https://www.euroleaguebasketball.net/en/euroleague/news/milan-josh-nebo-out-for-three-weeks/) last played in Round 2 due to a thigh injury.\n\n### FC Barcelona\n\nBarcelona has not yet sent an injury report for its game at Partizan on Friday.\n\n- [Nico Laprovittola last played in Round 2](https://www.euroleaguebasketball.net/en/euroleague/news/barcelonas-nico-laprovittola-sidelined-with-a-thigh-injury/) due to a left thigh adductor injury he suffered against Panathinaikos.\n- [Juan Nunez is out ](https://www.euroleaguebasketball.net/en/euroleague/news/barcelona-guard-juan-nunez-to-miss-6-months/)due to a knee injury. He expected to be sidelined until April.\n\n### FC Bayern Munich\n\nBayern has not yet sent an injury report for its game against Virtus on Thursday.\n\n- [New signing Spencer Dinwiddie](https://www.euroleaguebasketball.net/en/euroleague/news/bayern-brings-nba-veteran-spencer-dinwiddie-aboard/) has been registered and is in line to make his debut in Round 8.\n- Niels Giffey, who played the first six games of the season, missed Round 7.\n- Johannes Voigtmann made his first appearance of the season in Round 7, having recovered from a knee injury that required surgery.\n- [Rokas Jokubaitis](https://www.euroleaguebasketball.net/en/euroleague/news/bayerns-rokas-jokubaitis-suffers-knee-injury/) will be sidelined until the spring following knee surgery.\n- Elias Harris has yet to return to action following a knee injury suffered in June.\n- Aleksa Radanov (coach's decision) did not suit up for the first seven rounds.\n\n### Fenerbahce Beko Istanbul\n\nBrandon Boston and Arturs Zagars are ruled out for Fenerbahce's game at Real Madrid on Thursday, the club has confirmed.\n\n- Brandon Boston (sprained ankle) last played in Round 2, when he got injured against Zalgiris. He is currently in his recovery process.\n- [Arturs Zagars is dealing with a hamstring issue](https://www.euroleaguebasketball.net/euroleague/news/fenerbahce-arturs-zagars-dealing-with-hamstring-issue/), the club confirmed on October 18.\n\n### Hapoel IBI Tel Aviv\n\nHapoel has not yet sent an injury report for its game at Olympiacos on Friday.\n\n- [Yam Madar](https://www.euroleaguebasketball.net/en/euroleague/news/hapoels-yam-madar-goes-under-the-knife/) has not played this season after undergoing an appendectomy, and now will undergo a knee procedure and will miss a month of action, according to coach Dimitris Itoudis.\n\n- [Bruno Caboclo](https://www.euroleaguebasketball.net/en/euroleague/news/hapoel-bruno-caboclo-undergoes-back-surgery/) is recovering from back surgery. There is no timetable for his recovery.\n\n### LDLC ASVEL Villeurbanne\n\nASVEL has not yet sent an injury report for its game at Zalgiris on Thursday.\n\n- [Edwin Jackson](https://www.leprogres.fr/sport/2025/10/20/asvel-plus-de-peur-que-de-mal-pour-edwin-jackson) last played in Round 5.\n- Thomas Heurtel missed the first seven rounds.\n- Shaquille Harrison last played in Round 2.\n\n### Maccabi Rapyd Tel Aviv\n\nMaccabi has not yet sent an injury report for its game against Crvena Zvezda on Thursday.\n\n- Maccabi had no injuries to report in Round 7.\n- Uros Trifunovic has not played since Round 1.\n- Gur Lavi made his season debut in Round 4 but did not feature in Rounds 5 or 6.\n\n### Olympiacos Piraeus\n\nOlympiacos has not yet sent an injury report for its game against Hapoel on Friday.\n\n- Keenan Evans has not played so far this season due to a knee injury, but he has started training on an individual basis.\n- [Moustapha Fall](https://www.euroleaguebasketball.net/en/euroleague/news/olympiacos-center-moustapha-fall-suffers-knee-injury/) could miss the entire season after suffering a ruptured patellar tendon in his left knee during the Greek League finals in June.\n\n### Panathinaikos AKTOR Athens\n\nPanathinaikos has not yet sent an injury report for its game at Monaco on Friday.\n\n- [Richaun Holmes suffered a torn medial collateral ligament](https://x.com/Paobcgr/status/1983302468785319949) in his right knee in Round 7. Coach Ataman said that he would be out for over a month.\n- Nikos Rogkavopoulos was unavailable in Round 7.\n- Mathias Lessort is expected to be out until at least November, according to statements made by coach Ergin Ataman.\n- Alexandros Samodurov suffered a fracture in the middle finger of his right hand, the club confirmed.\n\n### Paris Basketball\n\nParis has not yet sent an injury report for its game at Milan on Thursday.\n\n- [Lamar Stevens](https://www.euroleaguebasketball.net/en/euroleague/news/paris-duo-lamar-stevens-sebastian-herrera-out-for-weeks/) has not featured for Paris so far this season.\n\n### Partizan Mozzart Bet Belgrade\n\nPartizan has not yet sent an injury report for its game against Barcelona on Friday. \n\n- Nick Calathes has been registered and is available and has joined the team.\n- [Carlik Jones is believed to have broken a bone in his foot](https://www.mozzartsport.com/kosarka/vesti/kraj-godine-za-karlika-dzonsa/526090) and, according to reports, could be out for the next three months. He last played in Round 5.\n- [Shake Milton](https://www.euroleaguebasketball.net/en/euroleague/news/shake-milton-to-miss-partizans-double-round-trip-to-spain/) (ankle) last played in Round 3.\n- Mario Nakic is expected to be sidelined for a while due to a knee problem.\n\n### Real Madrid\n\nReal Madrid has not yet sent an injury report for its game against Fenerbahce on Thursday.\n\n- Andres Feliz last played in Round 5.\n- Gabriele Procida has not played in the first seven rounds this season, but he has made three appearances in the Spanish League, including this past weekend.\n\n### Valencia Basket\n\nValencia has not yet sent an injury report for its game against Dubai on Thursday.\n\n- [New signing Braxton Key](https://www.euroleaguebasketball.net/en/euroleague/news/valencia-strengthens-frontcourt-with-braxton-key/) has not yet been registered.\n- [Sergio De Larrea missed Round 7](https://x.com/valenciabasket/status/1983193214376132876) due to minor discomfort.\n- Yankuba Sima has not played so far this season.\n\n### Virtus Bologna\n\nAbramo Canka remains Virtus's only absentee for its game at Bayern on Thursday, the club has confirmed.\n\n- Abramo Canka has not played so far this season.\n\n### Zalgiris Kaunas\n\nZalgiris has not yet sent an injury report for its game against ASVEL on Thursday.\n\n- [Nigel Williams-Goss suffered a hamstring injury](https://www.euroleaguebasketball.net/en/euroleague/news/nigel-williams-goss-sidelined-with-hamstring-injury/) in Round 6. He is out for the foreseeable future.\n- Dovydas Giedraitis is increasing his workload [after wrist surgery](https://www.euroleaguebasketball.net/en/euroleague/news/dovydas-giedraitis-to-miss-start-of-2025-26-season/), but he is still some weeks away from playing.","isHtml":false,"sponsor":null}],"categories":[{"text":"Euroleague News","id":"dd63261c-b945-4737-b3fb-ff56300747d0"},{"text":"Article","id":"2291d04f-de2b-4fa8-9755-219db77bf5da"},{"text":"Seasons","id":"2337e0ea-a3c8-488e-b338-5fdc76cb933b"},{"text":"2025-26","id":"d9570b85-5aff-4d8e-8515-fa05b83552a8"}],"language":"en","localisedVersions":[],"articleMetadata":{"title":"Injury report: Round 7","description":"Stay up to date with the latest information provided by the EuroLeague clubs ahead of Round 7 of the 2025-26 season.","ogTitle":null,"ogDescription":null,"ogType":null,"ogImageUrl":null,"twitterCard":null,"twitterSite":null,"twitterCreator":null}},{"pageType":"Article","generatedUrl":"/en/euroleague/news/tae2526-rs7-insight-hta-par/","id":"0c81e2d1-c029-416c-89a5-327c3efeb8e7","publishDate":"2025-10-29T21:29:43.327Z","lastModified":"2025-10-29T21:30:17.196Z","displayCategory":{"id":"76b004d5-fa1c-4e2e-9f81-74449f209637","text":"Game Report"},"author":{"name":"Zoran Milosavljevic","title":null,"imageUrl":null,"socialHandles":[]},"slug":"tae2526-rs7-insight-hta-par","heroMedia":{"content":{"contentType":"IMAGE","image":"https://media-cdn.cortextech.io/f3fc8ea8-0ec3-4a15-a613-2e7d862b46ed.jpg?crop=1315%3A740%3Anowe%3A0%3A0","title":null,"description":""},"title":"Mighty Hapoel rolls on to beat Partizan and stay top of the standings","summary":"The season’s surprise package pulled off an impressive win after seven of its players scored in double figures"},"linkedIds":[{"text":"Euroleague","sourceSystem":"FS_BASKETBALL_COMPETITION","sourceSystemId":"E"},{"sourceSystem":"FS_BASKETBALL_SEASON","sourceSystemId":"E2025"},{"text":"Hapoel Tel Aviv","sourceSystem":"FS_BASKETBALL_TEAM","sourceSystemId":"HTA"},{"text":"Partizan Mozzart Bet Belgrade","sourceSystem":"FS_BASKETBALL_TEAM","sourceSystemId":"PAR"},{"text":"Hapoel IBI Tel Aviv v Partizan Mozzart Bet Belgrade (2025-10-29T18:00:00.000Z)","sourceSystem":"FS_BASKETBALL_MATCH","sourceSystemId":"69"},{"sourceSystem":"MEDIA","sourceSystemId":"f3fc8ea8-0ec3-4a15-a613-2e7d862b46ed"}],"readTimeMinutes":3,"auth":{"loginRequired":null,"roles":[],"entitlements":[]},"content":[{"id":"2726021a-4832-4a4c-be43-48cf5e657ebf","contentType":"GAME_STAT_COMPONENT","status":"Show"},{"id":"172f5031-8a4a-441c-a063-0daf5fcf8ec0","contentType":"TEXT","text":"[Hapoel IBI Tel Aviv](https://www.euroleaguebasketball.net/euroleague/teams/hapoel-ibi-tel-aviv/hta/) marched on relentlessly and improved to 6-1 after a glitzy 97-84 home win over [Partizan Mozzart Bet Belgrade](https://www.euroleaguebasketball.net/euroleague/teams/partizan-mozzart-bet-belgrade/par/) on Wednesday night, as selfless teamwork saw the Israeli side blow away its rival on the back of an effervescent second-half performance.\n\nCoach Dimitris Itoudis celebrated a sweet win over his former mentor and close friend Zeljko Obradovic, with the two forming an unbreakable bond during a glorious 1999-2012 spell at Panathinaikos AKTOR Athens where they won five EuroLeague titles together.\n\nBoasting a deep roster at Hapoel, Itoudis emerged as a worthy winner in Sofia. The noisy Partizan fans made the Serbian outfit feel at home, although it’s currently Hapoel’s turf until the club’s long-awaited return to its Tel Aviv base in December.","isHtml":false,"sponsor":null},{"id":"2fb9d5b5-5136-4fe2-bdde-1f74031760af","contentType":"TEXT","text":"\u003ccenter\u003e\n\u003cblockquote class=\"twitter-tweet\"\u003e\u003cp lang=\"en\" dir=\"ltr\"\u003eAnother W on the board for \u003ca href=\"https://twitter.com/HapoelTLVBC?ref_src=twsrc%5Etfw\"\u003e@HapoelTLVBC\u003c/a\u003e, led by a career-high–tying performance from \u003ca href=\"https://twitter.com/CollinMalcolm?ref_src=twsrc%5Etfw\"\u003e@CollinMalcolm\u003c/a\u003e ✅\u003ca href=\"https://twitter.com/hashtag/EveryGameMatters?src=hash\u0026amp;ref_src=twsrc%5Etfw\"\u003e#EveryGameMatters\u003c/a\u003e \u003ca href=\"https://t.co/L5ZKLoApOr\"\u003epic.twitter.com/L5ZKLoApOr\u003c/a\u003e\u003c/p\u003e\u0026mdash; EuroLeague (@EuroLeague) \u003ca href=\"https://twitter.com/EuroLeague/status/1983626938381193711?ref_src=twsrc%5Etfw\"\u003eOctober 29, 2025\u003c/a\u003e\u003c/blockquote\u003e \u003cscript async src=\"https://platform.twitter.com/widgets.js\" charset=\"utf-8\"\u003e\u003c/script\u003e","isHtml":true,"sponsor":null},{"id":"d2bf6259-1ebf-45c4-abbe-c007d510b7eb","contentType":"TEXT","text":"No less than seven Hapoel players scored in double figures and the outcome epitomized the team’s unselfish approach as [Collin Malcolm](https://www.euroleaguebasketball.net/euroleague/players/collin-malcolm/012609/) led the way on 17 points and 7-of-8 shooting from the floor, with the hosts sinking 12 of 26 three-pointers in a high-octane clash.\n\nHaving praised his teammates, Malcolm also struck a note of caution that Hapoel should take nothing for granted so early in the season, despite making the headlines time and again since the club hit uncharted territory by joining Europe’s premier club competition this term.\n\n“We did a really good job handling their physicality and pressure in the second half and once we started finding the right guys, we started to score,” Malcolm said in his post-game comments. “It’s good to see that we’re progressing but nobody won the league after seven rounds so we’ve still got a long way to go. This team is capable of a lot of good things so we’re now focused on Round 8 and the matchup with Olympiacos.”\n\nBig man [Dan Oturu](https://www.euroleaguebasketball.net/euroleague/players/dan-oturu/012788/) racked up 14 points and 6 boards, [Antonio Blakeney](https://www.euroleaguebasketball.net/euroleague/players/antonio-blakeney/013402/) added 13 points while [Chris Jones](https://www.euroleaguebasketball.net/euroleague/players/chris-jones/010568/) chipped in with 12. [Ish Wainright](https://www.euroleaguebasketball.net/euroleague/players/ish-wainright/013284/) and [Elijah Bryant](https://www.euroleaguebasketball.net/euroleague/players/elijah-bryant/009846/) added 11 apiece and [Vasilije Micic](https://www.euroleaguebasketball.net/euroleague/players/vasilije-micic/002580/) sank 10 to round up Hapoel’s smooth all-round display which saw Partizan reeling throughout the second half after staying on an even keel in the opening 20 minutes.","isHtml":false,"sponsor":null},{"id":"a2dcb570-0b6a-4b3d-9a6b-891d0260d67e","contentType":"TEXT","text":"\u003ccenter\u003e\n\u003cblockquote class=\"twitter-tweet\"\u003e\u003cp lang=\"qme\" dir=\"ltr\"\u003e❤️🤍 \u003ca href=\"https://t.co/RAXhr2uelI\"\u003epic.twitter.com/RAXhr2uelI\u003c/a\u003e\u003c/p\u003e\u0026mdash; Hapoel Tel Aviv BC (@HapoelTLVBC) \u003ca href=\"https://twitter.com/HapoelTLVBC/status/1983629496348766454?ref_src=twsrc%5Etfw\"\u003eOctober 29, 2025\u003c/a\u003e\u003c/blockquote\u003e \u003cscript async src=\"https://platform.twitter.com/widgets.js\" charset=\"utf-8\"\u003e\u003c/script\u003e","isHtml":true,"sponsor":null},{"id":"d77005a7-8828-49cd-a87e-d22409115180","contentType":"TEXT","text":"The visiting team’s new signing [Bruno Fernando](https://www.euroleaguebasketball.net/euroleague/players/bruno-fernando/013667/) made a limited impact in the paint as the big man from Angola finished on 6 points and 3 boards, with [Sterling Brown](https://www.euroleaguebasketball.net/euroleague/players/sterling-brown/012720/) pacing Partizan on 19 points and [Duane Washington](https://www.euroleaguebasketball.net/euroleague/players/duane-washington/013370/) adding 15. They were the only two visiting players in double figures, however, with the long-term absence of livewire playmaker [Carlik Jones](https://www.euroleaguebasketball.net/euroleague/players/carlik-jones/013369/) beginning to bite hard as Partizan slipped to 3-4 after a second successive crushing defeat following the previous round’s 83-101 home drubbing by Paris Basketball.\n\nHaving singled out Malcolm, Coach Itoudis underlined that Hapoel’s deep roster gave him plenty of options at both ends of the court. “We’re a new team and still getting to know each other but we had a good second half, scoring 54 points and shooting 7 of 14 from three-point range,” the Greek tactician said.\n\n“Congrats to the players, we managed to win even though we didn’t have a great game. A deep roster helps in having different protagonists every game. The bench contributes too while Malcolm is effective all over, on offense and defense.”\n\nObradovic, who faces an uphill battle to get his shorthanded team back on track with guard [Shake Milton](https://www.euroleaguebasketball.net/euroleague/players/shake-milton/014007/) also sidelined by injury, could only acknowledge that is men fell woefully short in a lop-sided second half.  “It was a game of two different halves,” said the winner of a record nine EuroLeague titles with five different clubs. “The first half was close but in the second we made all sorts of mistakes as our defense was terrible and Hapoel fully deserved their win.”  ","isHtml":false,"sponsor":null},{"id":"199f0244-8beb-4ab3-b98d-af557e79275e","contentType":"RELATED_CONTENT","title":"Game News","relatedParameters":{"articleId":"0c81e2d1-c029-416c-89a5-327c3efeb8e7","relatedCategories":[],"specificContent":[],"tags":[],"linkedId":{"text":"Hapoel IBI Tel Aviv v Partizan Mozzart Bet Belgrade (2025-10-29T18:00:00.000Z)","sourceSystem":"FS_BASKETBALL_MATCH","sourceSystemId":"69"}}},{"id":"89255f47-de88-42f7-8b55-76f78517105c","contentType":"GAME_LEADERS_COMPONENT","status":"Show"}],"categories":[{"text":"Euroleague News","id":"dd63261c-b945-4737-b3fb-ff56300747d0"},{"text":"Game Report","id":"76b004d5-fa1c-4e2e-9f81-74449f209637"},{"text":"Seasons","id":"2337e0ea-a3c8-488e-b338-5fdc76cb933b"},{"text":"2025-26","id":"d9570b85-5aff-4d8e-8515-fa05b83552a8"}],"language":"en","localisedVersions":[],"articleMetadata":{"title":"Mighty Hapoel rolls on to beat Partizan and stay top of the standings","description":"Hapoel IBI Tel Aviv marched on relentlessly and improved to 6-1 after a glitzy 97-84 home win over Partizan Mozzart Bet Belgrade on Wednesday night, as selfless teamwork saw the Israeli side blow away its rival on the back of an effervescent second-half performance.","ogTitle":null,"ogDescription":null,"ogType":null,"ogImageUrl":null,"twitterCard":null,"twitterSite":null,"twitterCreator":null}}]},"currentSeasonCode":"E2025","currentRound":8,"roundCountdown":{"contentType":"ROUND_COUNTDOWN","id":"ba5efa6c-1e11-493b-9a9e-9b3ef2ab252a","competition":"E","seasonId":"E2025","date":"2025-10-30","time":"18:00","imageUrl":"https://media-cdn.cortextech.io/c50c0023-f0a1-4b98-988a-a0194362e7a3.png?crop=994%3A404%3Anowe%3A341%3A405","sponsorColor":null,"sponsorTextColor":null,"useBorderForCard":false},"teamStandingsTable":{"HTA":1,"ZAL":2,"RED":3,"PAN":4,"OLY":5,"PRS":6,"MCO":7,"PAM":8,"BAR":9,"VIR":10,"MAD":11,"ULK":12,"DUB":13,"IST":14,"PAR":15,"MUN":16,"MIL":17,"ASV":18,"TEL":19,"BAS":20},"surroundingBanners":null}},"page":"/euroleague","query":{},"buildId":"G9U1I06QZsA2Ho8HJr2bf","isFallback":false,"isExperimentalCompile":false,"dynamicIds":[94579,56626,58964,63413,67547,50920,97651,16510,34589,34281],"gsp":true,"appGip":true,"locale":"en","locales":["en","tr","el","es","lt","sr","it","fr","de","ru"],"defaultLocale":"en","scriptLoader":[]}</script></body></html>